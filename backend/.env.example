# Copy to .env and adjust as needed. All settings use the STEM_ prefix.
STEM_APP_NAME="STEM Mastery API"
STEM_VERSION="0.1.0"
STEM_ENV="development"
STEM_API_PREFIX="/api/v1"
# JSON array of allowed CORS origins, e.g. ["http://localhost:8081"]
STEM_CORS_ORIGINS=["*"]

# Neo4j AuraDB (authoritative curriculum graph). Leave the URI blank to run
# without a database: catalog endpoints then return 503 and the app still boots.
STEM_NEO4J_URI=""
STEM_NEO4J_USER="neo4j"
STEM_NEO4J_PASSWORD=""
STEM_NEO4J_DATABASE="neo4j"

# Supabase (authoritative learner state: profiles, progress, mastery).
# The service-role key is used server-side only and must never reach the app.
# JWKS is derived from STEM_SUPABASE_URL unless STEM_SUPABASE_JWKS_URL is set.
STEM_SUPABASE_URL=""
STEM_SUPABASE_SERVICE_ROLE_KEY=""
STEM_SUPABASE_JWKS_URL=""

# SciBERT (semantic entity extraction, app/services/scibert_service.py).
# The path is resolved relative to the backend project root. The 418 MB model
# is lazy-loaded on the first inference — never at startup and never on
# ordinary catalog requests. Leave the path blank to disable the /semantic/*
# endpoints (they then answer 503) without affecting anything else.
STEM_SCIBERT_MODEL_PATH="models/stem_scibert_final"
STEM_SCIBERT_MIN_CONFIDENCE="0.80"
# Prototype limit; reject /semantic requests whose text exceeds this length.
STEM_SCIBERT_MAX_TEXT_CHARS="5000"
