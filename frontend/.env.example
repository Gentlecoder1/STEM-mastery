# Supabase project settings.
# Copy this file to `.env` and fill in the values from your Supabase dashboard
# (Project Settings -> API). The anon key is a public client key and is safe to
# ship in the app; never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend. Leave blank to run fully offline (the app
# falls back to the local cache and never calls the network). Point this at the
# deployed backend, e.g. https://stem-mastery.vercel.app
EXPO_PUBLIC_API_URL=
